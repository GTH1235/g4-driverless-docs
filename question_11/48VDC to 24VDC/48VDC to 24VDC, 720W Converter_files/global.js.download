jQuery(document).ready(function($){
	
	var filter_group = $('.wcf-filter-group');
	var global_timeout_notif = 0;
	var curr_taxonomy = '';
	var product_count = '';

	// WCF 1 exposes products_count; WCF 2 leaves Product Table/DataTables as the
	// result-count owner and does not provide that legacy property.
	if(!(window.cims_wcf_compat && window.cims_wcf_compat.is_v2) && typeof WCF_Frontend !== 'undefined') {
		var curr_taxonomy = WCF_Frontend.current_taxonomy.term_id? WCF_Frontend.current_taxonomy.term_id :false;
		var product_count = WCF_Frontend.products_count? WCF_Frontend.products_count :false;
	}

	$.urlParam = function(name){
		var results = new RegExp('[\?&]' + name + '=([^&#]*)').exec(window.location.href);
		if (results==null) {
		   return null;
		}
		return decodeURI(results[1]) || 0;
	}	

	// IMS FILTER-NATIVE (2026-06-07): run a callback once the WCF filter UI has
	// rendered (or after a short cap), used only for lightweight UX/width
	// housekeeping now that Barn2 drives filtering + narrowing natively. This was
	// previously referenced but its definition went missing, throwing a
	// ReferenceError on _wcf_filter page load and on every filter click (the
	// "nothing happens / huge delay" symptom). Defined defensively so a missing
	// callback or jQuery context can never break the page.
	function cimsRunWhenFilterReady(cb, maxWaitMs, intervalMs) {
		if (typeof cb !== 'function') { return; }
		maxWaitMs = (typeof maxWaitMs === 'number') ? maxWaitMs : 1500;
		intervalMs = (typeof intervalMs === 'number') ? intervalMs : 100;
		var waited = 0;
		function _ready() {
			try {
				if (!$('.wcf-group-wrapper, .wcf-group').length) { return false; }
				if (!$('.wcf-filter-form, .wcf-filter, .wcf-filter-group').length) { return false; }
				return true;
			} catch (e) { return true; }
		}
		(function _tick(){
			var done = false;
			try { done = _ready(); } catch (e) { done = true; }
			if (done || waited >= maxWaitMs) {
				try { cb(); } catch (e) { if (window.console) { console.error('cimsRunWhenFilterReady cb error', e); } }
				return;
			}
			waited += intervalMs;
			setTimeout(_tick, intervalMs);
		})();
	}
	

	// IMS PATCH (2026-05-07): render safe <sub>/<sup> markup in WCF filter labels.
	// WCF decodes the DB label string and React renders it as text; only these exact
	// allowlisted scientific labels are converted to DOM nodes after WCF renders.
	var _filter_safe_subsup_label_fragments = {
		'M<sub>t</sub>': [ { text: 'M' }, { tag: 'sub', text: 't' } ],
		'M&lt;sub&gt;t&lt;/sub&gt;': [ { text: 'M' }, { tag: 'sub', text: 't' } ],
		'F<sub>ax</sub>': [ { text: 'F' }, { tag: 'sub', text: 'ax' } ],
		'F&lt;sub&gt;ax&lt;/sub&gt;': [ { text: 'F' }, { tag: 'sub', text: 'ax' } ]
	};

	function _filter_append_safe_subsup_fragment(fragment, parts) {
		for (var i = 0; i < parts.length; i++) {
			var part = parts[i];
			if (part.tag) {
				var el = document.createElement(part.tag);
				el.textContent = part.text;
				fragment.appendChild(el);
			} else {
				fragment.appendChild(document.createTextNode(part.text));
			}
		}
	}

	function _filter_find_next_safe_subsup_token(text, start) {
		var best = null;
		Object.keys(_filter_safe_subsup_label_fragments).forEach(function(token){
			var index = text.indexOf(token, start);
			if (index === -1) {
				return;
			}
			if (!best || index < best.index || (index === best.index && token.length > best.token.length)) {
				best = { index: index, token: token };
			}
		});
		return best;
	}

	function _filter_replace_safe_subsup_text_node(text_node) {
		if (!text_node || !text_node.nodeValue) {
			return false;
		}

		var parent = text_node.parentNode;
		if (!parent || /^(SCRIPT|STYLE|TEXTAREA|INPUT|SELECT|OPTION)$/i.test(parent.nodeName)) {
			return false;
		}

		var text = text_node.nodeValue;
		var next = _filter_find_next_safe_subsup_token(text, 0);
		if (!next) {
			return false;
		}

		var fragment = document.createDocumentFragment();
		var cursor = 0;
		while (next) {
			if (next.index > cursor) {
				fragment.appendChild(document.createTextNode(text.slice(cursor, next.index)));
			}
			_filter_append_safe_subsup_fragment(fragment, _filter_safe_subsup_label_fragments[next.token]);
			cursor = next.index + next.token.length;
			next = _filter_find_next_safe_subsup_token(text, cursor);
		}
		if (cursor < text.length) {
			fragment.appendChild(document.createTextNode(text.slice(cursor)));
		}

		parent.replaceChild(fragment, text_node);
		return true;
	}

	function _filter_render_safe_subsup_markup(timeout) {
		timeout = parseInt(timeout, 10) || 0;
		setTimeout(function(){
			var roots = document.querySelectorAll('.wcf-filter-form, .wcf-filter-group, .wcf-active-filters, .wcf-dropdown-wrapper, [role="listbox"]');
			if (!roots.length) {
				return;
			}

			Array.prototype.forEach.call(roots, function(root){
				var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
					acceptNode: function(node) {
						return _filter_find_next_safe_subsup_token(node.nodeValue || '', 0) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
					}
				});

				var nodes = [];
				while (walker.nextNode()) {
					nodes.push(walker.currentNode);
				}
				nodes.forEach(_filter_replace_safe_subsup_text_node);
			});
		}, timeout);
	}

	var _filter_safe_subsup_observer = null;
	function _filter_bind_safe_subsup_observer() {
		if (_filter_safe_subsup_observer || typeof MutationObserver === 'undefined' || !document.body) {
			return;
		}

		var scheduled = false;
		_filter_safe_subsup_observer = new MutationObserver(function(){
			if (scheduled) {
				return;
			}
			scheduled = true;
			setTimeout(function(){
				scheduled = false;
				_filter_render_safe_subsup_markup(0);
			}, 50);
		});
		_filter_safe_subsup_observer.observe(document.body, { childList: true, subtree: true, characterData: true });
	}

	// Add tooltip to title
	function _filter_title_tooltip() {
		// WCF 2 owns its filter-title DOM. Keep this legacy augmentation on WCF 1 only.
		if ( window.cims_wcf_compat && window.cims_wcf_compat.is_v2 ) {
			return;
		}
		$('.wcf-filter-title img').remove();
		$('.wcf-filter-title').each(function(){
			let curr_text = jQuery(this).text();
				curr_text = curr_text.replace(/^\s+|\s+$/g, ''); // trim
				curr_text = curr_text.toLowerCase();
				curr_text = curr_text.replace('.', '-') // replace a dot by a dash 
						.replace(/[^a-z0-9 -]/g, '') // remove invalid chars
						.replace(/\s+/g, '-') // collapse whitespace and replace by a dash
						.replace(/-+/g, '-') // collapse dashes
						.replace( /\//g, '' ); // collapse all forward-slashes
				$(this).append(`<img src="/wp-content/plugins/catalog-ims/assets/images/svg/question-mark.svg" data-tooltip="filter_${curr_text}" class="open_tooltip" width="14" alt="This is text"><div id="filter_${curr_text}" class="tooltip_box"></div>`);

		});		
	}
	
	$(window).load(_filter_title_tooltip);
	$(window).load(function(){
		_filter_render_safe_subsup_markup(0);
		_filter_render_safe_subsup_markup(500);
		_filter_bind_safe_subsup_observer();
	});
	
	// IMS NATIVE 2026-06-07 (audit Y4): removed the dead
	// `_filter_custom_checked_filter_button` (its body was commented out; live it
	// only started a do-nothing 1s setInterval poll) and its `!_wcf_filter`
	// window.load binding. Active-filter chip styling is owned natively by WCF.
	
	// CIMS-WCF-AXIOMATIC-FIVE-ROW-SCROLL-01 (2026-07-31): show at most five
	// complete checkbox rows per attribute, with every remaining choice available by scrolling.
	// Barn2 owns native ScrollbarsCustom lists; ordinary checkbox lists receive only a scoped
	// browser scroll class. This changes presentation only, not WCF choice/filter semantics.
	function _filter_limit_checkbox_display(timeout) {
		var delay = timeout ? 2000 : 0;

		setTimeout(function(){
			$('.wcf-filter').each(function(){
				var $filter = $(this);
				var $native_scroll_list = $filter.find('.ScrollbarsCustom div[role="list"]').first();
				var $native_scroll_box = $native_scroll_list.closest('.ScrollbarsCustom');

				// Remove stale legacy markup and restore any rows previously hidden by More+.
				$filter.find('.filter-more').remove();

				if ( $native_scroll_list.length ) {
					var $native_rows = $native_scroll_list.children('div');
					$native_rows.css('display', '');
					if ( $native_rows.length > 5 ) {
						var native_row_height = Math.ceil($native_rows.first().outerHeight(true));
						if ( native_row_height > 0 ) {
							$native_scroll_box.css('--cims-filter-row-height', native_row_height + 'px');
						}
						$native_scroll_box.addClass('cims-five-row-native-scroll');
					} else {
						$native_scroll_box.removeClass('cims-five-row-native-scroll').css('--cims-filter-row-height', '');
					}
					$native_scroll_list.addClass('active');
					return;
				}

				var $wcf2CheckboxGroup = $filter.find('[role="group"].wcf-checkbox-group').first();
				if ( $wcf2CheckboxGroup.length ) {
					var $wcf2Rows = $wcf2CheckboxGroup.children('label.wcf-checkbox-item');
					if ( $wcf2Rows.length > 5 ) {
						// WCF 2's Radix group adds a separate flex gap. Its rendered row
						// height alone is therefore not its visual step and cannot safely
						// determine a five-row viewport. The scoped WCF 2 CSS owns the
						// compact 30px row geometry and 150px long-list viewport; retain
						// only this semantic class for older browser fallback paths.
						$wcf2CheckboxGroup.addClass('cims-five-row-scroll').css('--cims-filter-row-height', '');
					} else {
						$wcf2CheckboxGroup.removeClass('cims-five-row-scroll').css('--cims-filter-row-height', '');
					}
					return;
				}

				var $list = $filter.find('div[role="list"]').first();
				if ( !$list.length ) {
					return;
				}
				var $rows = $list.children('div');
				$rows.css('display', '');
				if ( $rows.length > 5 ) {
					var row_height = Math.ceil($rows.first().outerHeight(true));
					if ( row_height > 0 ) {
						$list.css('--cims-filter-row-height', row_height + 'px');
					}
					$list.addClass('cims-five-row-scroll');
				} else {
					$list.removeClass('cims-five-row-scroll').css('--cims-filter-row-height', '');
				}
				$list.addClass('active');
			});
		}, delay);
	}

	
	$(window).load(_filter_limit_checkbox_display);
	
	// Fix checked filter button click
	function _filter_button_click(timeout) {
		$(document).on("click", ".wcf-active-filter svg", function(){
			// $('.wcf-active-filters .wcf-active-filter em').remove();
			_filter_limit_checkbox_display(3000);				
		});		
	}
	
	$(window).load(_filter_button_click);

	// CIMS-WCF-TABLE-WIDTH-01 (2026-06-03): keep Barn2 Product Table
	// column widths stable after WCF filters redraw/reinitialize the table.
	var _filter_product_table_widths = null;
	// CIMS-WCF-TABLE-WIDTH-03 (2026-06-05): track how authoritative the cached
	// widths are (2 = declared data-width, 1 = deterministic reconstruction) so a
	// provisional capture can be upgraded by a later clean one and a bad capture
	// never sticks until a manual refresh.
	var _filter_product_table_widths_source = 0;

	function _filter_parse_width_percent(width) {
		if ( typeof width === 'undefined' || width === null ) {
			return 0;
		}
		var parsed = parseFloat(String(width).replace('%', ''));
		return isNaN(parsed) || parsed <= 0 ? 0 : parsed;
	}

	// CIMS-WCF-TABLE-WIDTH-03 (2026-06-05): the server emits a deterministic
	// per-column width scheme (functions.php wc_product_table_args: the SKU/Item #
	// column gets catalog_ims_product_table_sku_width, default 15%, and the
	// remaining width is split evenly across the other columns, with
	// auto_width=false). Mirror that exact value here so the JS reconstruction
	// matches the server render. An optional JS override (WCF_Frontend or a global)
	// keeps the two in sync if the server filter value ever changes.
	function _filter_get_sku_width_percent() {
		var sku_width = 15;
		if ( typeof WCF_Frontend !== 'undefined' && WCF_Frontend && parseFloat(WCF_Frontend.cims_product_table_sku_width) > 0 ) {
			sku_width = parseFloat(WCF_Frontend.cims_product_table_sku_width);
		} else if ( typeof cims_product_table_sku_width !== 'undefined' && parseFloat(cims_product_table_sku_width) > 0 ) {
			sku_width = parseFloat(cims_product_table_sku_width);
		}
		if ( sku_width <= 0 ) { sku_width = 15; }
		if ( sku_width >= 95 ) { sku_width = 95; }
		return sku_width;
	}

	// CIMS-WCF-TABLE-WIDTH-03 (2026-06-05): reconstruct the deterministic server
	// width scheme from the column set (SKU column fixed %, the rest split evenly)
	// instead of measuring a possibly-filtered AJAX-injected table.
	function _filter_compute_deterministic_widths(headers) {
		var count = headers.length;
		if ( count <= 0 ) {
			return false;
		}
		if ( count === 1 ) {
			headers[0].percent = 100;
			return true;
		}

		var sku_index = -1;
		headers.forEach(function(header){
			if ( sku_index === -1 && String(header.name).toLowerCase() === 'sku' ) {
				sku_index = header.index;
			}
		});
		if ( sku_index === -1 ) {
			sku_index = headers[0].index;
		}

		var sku_width = _filter_get_sku_width_percent();
		var other_width = Math.max(0, 100 - sku_width) / Math.max(1, count - 1);
		headers.forEach(function(header){
			header.percent = ( header.index === sku_index ) ? sku_width : other_width;
		});
		return true;
	}

	function _filter_capture_product_table_widths(force) {
		var $table = $('.wc-product-table:visible').first();
		if ( !$table.length ) {
			$table = $('.wc-product-table').first();
		}
		if ( !$table.length ) {
			return;
		}

		var headers = [];
		$table.find('thead th').each(function(index){
			var $th = $(this);
			var data_width = $th.attr('data-width') || '';
			headers.push({
				index: index,
				name: $th.attr('data-name') || '',
				data_width: data_width,
				data_percent: _filter_parse_width_percent(data_width)
			});
		});

		if ( !headers.length ) {
			return;
		}

		// CIMS-WCF-TABLE-WIDTH-03 (2026-06-05): width source priority is
		// declared data-width -> deterministic reconstruction. The measured-pixel
		// fallback that CIMS-WCF-TABLE-WIDTH-02 still relied on (when a table had no
		// usable declared widths and _wcf_filter was absent) is removed: macro
		// parent pages render no table on initial load, so the FIRST filter injects
		// the table via AJAX with no _wcf_filter in the URL, and measuring that
		// already-filtered table pinned the wrong proportions until a manual
		// refresh. Reconstructing the deterministic server scheme yields the same
		// widths as the refreshed/server-rendered table, so the first filter is now
		// correct without a refresh.
		var declared_percent_total = 0;
		var declared_count = 0;
		headers.forEach(function(header){
			if ( header.data_percent > 0 ) {
				declared_percent_total += header.data_percent;
				declared_count += 1;
			}
		});
		var has_declared_widths = ( declared_count >= ( headers.length - 1 ) )
			&& declared_percent_total >= 90
			&& declared_percent_total <= 110;

		var source;
		if ( has_declared_widths ) {
			headers.forEach(function(header){
				header.percent = header.data_percent;
			});
			source = 2; // declared data-width (authoritative)
		} else if ( _filter_compute_deterministic_widths(headers) ) {
			source = 1; // deterministic reconstruction of the server scheme
		} else {
			return;
		}

		var percent_total = 0;
		headers.forEach(function(header){
			percent_total += header.percent || 0;
		});
		if ( percent_total <= 0 ) {
			return;
		}

		// Only overwrite when this capture is at least as authoritative as the
		// cached one (declared > deterministic), when forced, or when the table
		// column count changed. This upgrades an early provisional capture once a
		// clean declared capture is available and stops a stale bad capture from
		// sticking until a manual refresh, while never downgrading good declared
		// widths to a provisional reconstruction.
		var should_store = force
			|| !_filter_product_table_widths
			|| !_filter_product_table_widths.length
			|| ( _filter_product_table_widths.length !== headers.length )
			|| ( source >= _filter_product_table_widths_source );

		if ( should_store ) {
			_filter_product_table_widths = headers;
			_filter_product_table_widths_source = source;
		}
	}

	function _filter_apply_product_table_widths(timeout) {
		timeout = parseInt(timeout, 10) || 0;
		setTimeout(function(){
			// CIMS-WCF-TABLE-WIDTH-03 (2026-06-05): always re-run capture (non-forced)
			// so a provisional deterministic capture is upgraded once a clean declared
			// capture is available, and a transient/bad early capture cannot stick until
			// a manual refresh. The capture's own source/column-count guard prevents it
			// from downgrading good declared widths.
			_filter_capture_product_table_widths(false);
			if ( !_filter_product_table_widths ) {
				return;
			}

			$('.wc-product-table').each(function(){
				var $table = $(this);
				if ( !$table.length ) {
					return;
				}
				// CIMS-WCF-TABLE-WIDTH-04 (Y3, 2026-06-07): the colgroup + per-cell
				// width pin is now the single shared cimsApplyTableWidths(), reused by
				// both the leaf path (here, doAdjust=true) and the macro path
				// (window.cimsLockProductTableWidths, doAdjust=false). Behaviour
				// unchanged from the prior inline loop.
				cimsApplyTableWidths($table, _filter_product_table_widths, true);
			});
		}, timeout);
	}

	// CIMS-WCF-TABLE-WIDTH-04 (Y3, 2026-06-07): single shared colgroup + per-cell
	// width applier. Extracted verbatim from the prior leaf
	// _filter_apply_product_table_widths inner loop and the macro template's
	// cimsLockMacroTableWidths inner loop, which were duplicates. doAdjust mirrors the
	// only prior difference between them: the leaf path called DataTables
	// columns.adjust(); the macro path intentionally did not (it fights
	// table-layout:fixed).
	function cimsApplyTableWidths($table, headers, doAdjust) {
		if ( !$table || !$table.length || !headers || !headers.length ) {
			return;
		}

		// CIMS-WCF-CHIP-FLICKER-FIX-01 (2026-06-07): only rewrite the colgroup when it
		// actually changes. The remove()+prepend() below is a childList mutation on the
		// table, which sits inside .product_table_wrap_new -- the node watched by TWO
		// MutationObserver(childList+subtree) handlers in the macro template (one re-queues
		// THIS width lock, one re-renders the active-filter chips). Unconditionally
		// rewriting the colgroup re-triggered both observers, which re-ran the width lock,
		// which rewrote the colgroup... a ~120ms self-sustaining loop that tore down and
		// rebuilt the chip buttons ~8x/sec (visible flicker; the chip X was unclickable
		// because the button was recreated mid-click). Skipping the no-op rewrite breaks
		// the loop at its source. Per-cell width pins (attribute writes) and the optional
		// columns.adjust() are NOT childList mutations, so they stay unconditional below.
		var widthSig = headers.map(function(header){
			return Math.max(header.percent || 0, 1).toFixed(4);
		}).join('|');

		var colgroup = '<colgroup class="cims-wcf-product-table-widths" data-cims-width-sig="' + widthSig + '">';
		headers.forEach(function(header){
			var width = Math.max(header.percent || 0, 1).toFixed(4) + '%';
			colgroup += '<col style="width:' + width + ';" />';
		});
		colgroup += '</colgroup>';

		var $existingColgroup = $table.children('colgroup.cims-wcf-product-table-widths');
		var colgroupUnchanged = $existingColgroup.length === 1
			&& $existingColgroup.attr('data-cims-width-sig') === widthSig
			&& $existingColgroup.children('col').length === headers.length;

		if ( ! colgroupUnchanged ) {
			$existingColgroup.remove();
			$table.prepend(colgroup);
		}
		$table.addClass('cims-wcf-table-width-locked');


		headers.forEach(function(header){
			var width = Math.max(header.percent || 0, 1).toFixed(4) + '%';
			$table.find('thead th').eq(header.index).css({
				'width': width,
				'min-width': width,
				'max-width': width
			});
			$table.find('tbody tr').each(function(){
				$(this).children('td').eq(header.index).css({
					'width': width,
					'min-width': width,
					'max-width': width
				});
			});
		});

		if ( doAdjust ) {
			try {
				if ( $.fn.dataTable && $.fn.dataTable.isDataTable($table) ) {
					$table.DataTable().columns.adjust();
				}
			} catch(e) {}
		}
	}

	// CIMS-WCF-TABLE-WIDTH-04 (Y3, 2026-06-07): per-table declared-or-reconstruct
	// width computation, moved here from the macro template (cimsComputeMacroColumnWidths)
	// so the macro and leaf width-locks share one source of truth. Prefer each <th>'s
	// declared data-width when present on all-but-one column and summing to ~100%;
	// otherwise reconstruct the deterministic server scheme via
	// _filter_compute_deterministic_widths (SKU/Item # = _filter_get_sku_width_percent(),
	// default 15%, the rest split evenly). The macro copy previously hard-coded 12%;
	// routing through _filter_get_sku_width_percent() is identical at the default and
	// keeps the two in sync if catalog_ims_product_table_sku_width ever changes.
	function cimsComputeTableWidthHeaders($table) {
		var headers = [];
		$table.find('thead th').each(function(index){
			var $th = $(this);
			var declared = $th.attr('data-width') || $th.attr('width') || '';
			var pct = parseFloat(String(declared).replace('%', ''));
			headers.push({
				index: index,
				name: $th.attr('data-name') || '',
				percent: ( !isNaN(pct) && pct > 0 ) ? pct : 0
			});
		});
		if ( !headers.length ) {
			return headers;
		}

		var declared_count = 0, declared_total = 0;
		headers.forEach(function(header){
			if ( header.percent > 0 ) { declared_count++; declared_total += header.percent; }
		});
		var has_declared = ( declared_count >= ( headers.length - 1 ) )
			&& declared_total >= 90 && declared_total <= 110;
		if ( ! has_declared ) {
			if ( ! _filter_compute_deterministic_widths(headers) ) {
				return [];
			}
		}
		return headers;
	}

	// CIMS-WCF-TABLE-WIDTH-04 (Y3, 2026-06-07): public macro entry point. The macro
	// template (taxonomy-product_cat.php) now calls this instead of carrying its own
	// duplicate colgroup/lock implementation. Scoped to the macro results table by
	// default; doAdjust is false to match the macro's table-layout:fixed requirement.
	window.cimsLockProductTableWidths = function(scope){
		var selector = scope || '.cims-macro-filter-results table.wc-product-table';
		$(selector).each(function(){
			var $table = $(this);
			var headers = cimsComputeTableWidthHeaders($table);
			if ( !headers.length ) {
				return;
			}
			cimsApplyTableWidths($table, headers, false);
		});
	};


	// CIMS-WCF-FILTER-UX-01 (2026-06-03): preserve Barn2/WCF's native
	// active-filter chips/reset UI. The previous integration removed
	// #wcf-sorting-bar, which is the React mount that renders selected filter
	// tags and reset/remove controls above Product Table results.
	function _filter_get_clean_reset_url() {
		if ( typeof WCF_Frontend !== 'undefined' && WCF_Frontend.base_search_url ) {
			return WCF_Frontend.base_search_url;
		}

		if ( typeof cims_current_url !== 'undefined' && cims_current_url ) {
			return String(cims_current_url).split('?')[0].split('#')[0];
		}

		return window.location.origin + window.location.pathname;
	}

	function _filter_preserve_wcf_filter_ux() {
		var $sorting_bar = $('#wcf-sorting-bar');
		if ( !$sorting_bar.length ) {
			return;
		}

		$sorting_bar.addClass('cims-wcf-filter-ux-active');
		$sorting_bar.find('.wcf-results-count, .wcf-pool-drawer').addClass('cims-wcf-native-pool-hidden');
		$sorting_bar.toggleClass(
			'cims-wcf-has-active-filters',
			$sorting_bar.find('.wcf-active-filter').length > 0 || !!$.urlParam('_wcf_filter')
		);
	}

	var _filter_active_ux_observer = null;
	function _filter_bind_active_filter_ux_observer() {
		if ( _filter_active_ux_observer || typeof MutationObserver === 'undefined' || !document.body ) {
			return;
		}

		var scheduled = false;
		_filter_active_ux_observer = new MutationObserver(function(mutations){
			var relevant = false;
			for ( var i = 0; i < mutations.length; i++ ) {
				var target = mutations[i].target;
				if ( !target || target.nodeType !== 1 ) {
					continue;
				}

				var $target = $(target);
				if ( $target.closest('#wcf-sorting-bar, .wcf-active-filters, .wcf-filter-form').length || $target.find('#wcf-sorting-bar, .wcf-active-filters, .wcf-active-filter').length ) {
					relevant = true;
					break;
				}
			}

			if ( !relevant || scheduled ) {
				return;
			}

			scheduled = true;
			setTimeout(function(){
				scheduled = false;
				_filter_preserve_wcf_filter_ux();
				_filter_refresh_by(0);
				_filter_render_safe_subsup_markup(0);
				_filter_apply_product_table_widths(0);
			}, 100);
		});
		_filter_active_ux_observer.observe(document.body, { childList: true, subtree: true });
	}

	// Refresh filter
	function _filter_refresh_by(timeout) {
		if( typeof timeout === 'undefined' ) {
			timeout = 2000;
		} else {
			timeout = parseInt(timeout, 10) || 0;
		}

		setTimeout(function(){
			_filter_preserve_wcf_filter_ux();
			var count = $('.wcf-active-filter, .wcf-active-filter-badge').length;
			$('.tile_filter p span').remove();
			$('.tile_filter p').append('<span class="filter-counter" style="display:none">(<span></span>)</span>');

			$('.tile_filter p .filter-clear-all').remove();
			if( count > 0 ) {		
				$('.filter-counter span').text(count);
				$('.filter-counter').show();
				$('.tile_filter p').append('<a class="filter-clear-all cims-wcf-reset-all" href="'+_filter_get_clean_reset_url()+'">Reset filters</a>');
			}
		}, timeout);	
	}	
	
	$(window).load(_filter_refresh_by);
	
	// Refresh info
	function _filter_refresh_info(timeout) {
		if ( window.cims_wcf_compat && window.cims_wcf_compat.is_v2 ) {
			return;
		}
		if( timeout ) {
			timeout = 2000;
		}

		setTimeout(function(){
			var count = 0;
			$('.wc-product-table tbody>tr').each(function(){count += 1;});
			$('.dataTables_info').html(product_count +` ${global_part_text} (<span class="displayed-counter"></span>&nbsp;Displayed)`);
			$('.displayed-counter').text(count);
			$('.cgims-extra-options-part-counter').html('<span>'+product_count+`</span> ${global_part_text}`);
		}, timeout);	
	}	
	
	//$(window).load(_filter_refresh_info);	
	
	// IMS NATIVE 2026-06-07 (audit Y4): one idempotent post-render housekeeping pass.
	// Replaces the setTimeout-chained re-render ladders that raced Barn2's React /
	// DataTables redraw. Every step is safe to run repeatedly, so it can bind directly
	// to Barn2's public events and fire exactly when the DOM is ready. It does NOT touch
	// the dataTables_info / part-counter line (the existing draw.dt handler owns that),
	// the width-lock internals (Y3), or the macro chip engine (Y5).
	function _filter_post_render_housekeeping() {
		_filter_preserve_wcf_filter_ux();
		_filter_apply_product_table_widths(0);
		_filter_refresh_by(0);
		_filter_title_tooltip(0);
		_filter_render_safe_subsup_markup(0);
		_filter_limit_checkbox_display(0);
		$('#cgims-show').val("25");
		$('.multi-cart-check input[type=hidden]').attr('type', 'checkbox');
		var $cims_show_count = $('.wc-product-table-below select');
		if ( $cims_show_count.length && !$cims_show_count.children('option[value="5"]').length ) {
			$cims_show_count.prepend('<option value="5">5</option>');
		}
	}

	// IMS NATIVE 2026-06-07 (audit Y4): bind the housekeeping to Barn2's own public
	// events instead of setTimeout ladders. draw.wcpt is fired by WPT after every table
	// draw (filter reload / paginate / sort / show-count); wcpf.filteringDone is fired
	// by WCF when a filter request completes. Delegated on document so it also catches
	// the AJAX-injected macro table. wp.hooks is feature-detected so a WCF build change
	// can never throw here.
	$(document).on('draw.wcpt', '.wc-product-table', function(){
		_filter_post_render_housekeeping();
		$('.inside-filter').stop(true).fadeTo(100,1);
	});
	// CIMS-WCF-2-WPT-PAGINATION-01: WCF's rendered Product Table payload carries
	// pageLength as a string (for example "25"). DataTables 1.13 then concatenates
	// it while advancing pages ("0" + "25" -> "025"), leaving page two on the
	// first rows and dereferencing a missing row. Normalize every WCF-initialized
	// Catalog IMS category table once WPT has completed its own initialization.
	$(document).on('init.dt', 'section.sub_cat_catalog table.wc-product-table', function(){
		var table = this;
		setTimeout(function(){
			if ( !$.fn.dataTable || !$.fn.dataTable.isDataTable(table) ) {
				return;
			}
			try {
				var dataTable = $(table).DataTable();
				var currentLength = dataTable.page.len();
				var numericLength = parseInt(currentLength, 10);
				if ( numericLength > 0 && currentLength !== numericLength ) {
					dataTable.page.len(numericLength).draw(false);
				}
			} catch (e) {}
		}, 0);
	});
	if ( typeof wp !== 'undefined' && wp.hooks && typeof wp.hooks.addAction === 'function' ) {
		wp.hooks.addAction('wcpf.filteringDone', 'cims/filter-post-render', function(){
			_filter_post_render_housekeeping();
			$('.inside-filter').stop(true).fadeTo(100,1);
		});
	}
	$(document).on('wcf:products:afterRender wcf:url:afterUpdate wcf:url:afterDelete wcf:filter:afterRemoved', function(){
		setTimeout(function(){
			_filter_post_render_housekeeping();
			$('.inside-filter').stop(true).fadeTo(100,1);
		}, 0);
	});
	// WCF 2 dispatches native CustomEvents. Subscribe through the DOM API as
	// well as jQuery so redraw housekeeping always runs after React portals its
	// filters/results, URL state, or removed-filter controls.
	['wcf:products:afterRender', 'wcf:url:afterUpdate', 'wcf:url:afterDelete', 'wcf:filter:afterRemoved'].forEach(function(eventName){
		document.addEventListener(eventName, function(){
			setTimeout(function(){
				_filter_post_render_housekeeping();
				$('.inside-filter').stop(true).fadeTo(100,1);
			}, 0);
		});
	});

	// General
	$(window).load(function(){
		let first_time_load = 1;

		_filter_preserve_wcf_filter_ux();
		_filter_bind_active_filter_ux_observer();
		_filter_capture_product_table_widths(false);
		_filter_apply_product_table_widths(250);
		_filter_apply_product_table_widths(1000);

		$(document).on('change', '#cgims-sortby', function(){
			$('th[data-name=name]').click();
		});		
		
		$('.multi-cart-check input[type=hidden]').attr('type', 'checkbox');
		
		$('.wc-product-table-below select').prepend('<option value="5">5</option>');
		
		if( $.urlParam('_wcf_filter') ) {
			$('.inside-filter').fadeTo(500,0.1);
		   
			// IMS FILTER-NATIVE (2026-06-07): retired the custom greyout AJAX +
			// label-disabling. Barn2's native counts (inline WCF_Group counts +
			// /wcf/v1/counters) grey/hide unavailable choices automatically, so we
			// only restore the sidebar/table UX after the WCF frontend hydrates.
			cimsRunWhenFilterReady(function(){
				// IMS NATIVE 2026-06-07 (audit Y4): collapsed the setTimeout-chained
				// re-render ladder to one idempotent housekeeping pass run once the WCF UI
				// is ready; draw.wcpt / wcpf.filteringDone re-run it on later draws.
				$('.dataTables_info').hide();
				_filter_post_render_housekeeping();
				$('.inside-filter').fadeTo(100,1);
				$('.dataTables_info').show();
			});
		}

		$(document).on('click', '.cims-wcf-reset-all', function(e){
			if (window.cims_wcf_compat && window.cims_wcf_compat.is_v2) {
				e.preventDefault();
				document.dispatchEvent(new CustomEvent('wcf:filters:clearAll'));
			}
		});

		$(document).on('click', '.wcf-active-filter svg', function(){
			var label = $(this).parents('span').text();
			setTimeout(function(){
			$('.wcf-label-item').each(function(){				
				var lbl = $(this).text();
				if(label.indexOf(lbl) == -1){
				
				} else {
					var t = $(this);
					t.prev('input').prop('checked', false);						
					t.prev('input').removeAttr('checked');
					t.prev('input').removeAttr('aria-checked');	
					t.prev('input').addClass('unfilter');
				}
			});
			}, 1500);
		});
		
		$(document).on('mouseenter mouseleave hover', '.wcf-checkbox input.unfilter', function(e){
			console.log(123);
			$(this).attr('checked', false);	
			$(this).removeAttr('checked');
			$(this).removeAttr('aria-checked');
		});
		
		
		// Search results
		if( $('.search-results').length ) {
			$('.wc-product-table').on( 'draw.dt', function () {
				var product_count = $('.dataTables_info').text().replace( /[^\d.]/g, '' );
				$('.multi-cart-check input[type=hidden]').attr('type', 'checkbox');
				//$('.dataTables_info').html('<span class="total-parts">'+ product_count +'</span>&nbsp;Parts (<span class="displayed-counter"></span>&nbsp;Displayed)');	
				$('.displayed-counter').text($('.wc-product-table tbody tr').length);		
				$('.cgims-extra-options-part-counter span').text( product_count );
			});
			
			$(document).on('change', '.multi-cart-check input', function(){
				var checked = $('.multi-cart-check input:checked').length;
				if( checked>0 ) {
					$('.cgims-extra-options-part-counter').html('<span>'+checked+`</span> ${global_part_text} Selected`);
				} else {
					$('.cgims-extra-options-part-counter').html('<span>'+ $('.total-parts').text() +`</span> ${global_part_text}`);
				}
			});
		}
	});

	// IMS FILTER-NATIVE (2026-06-07): retired the custom greyout AJAX +
	// label-disabling on filter click. Barn2's licensed WCF frontend handles the
	// filter change itself — it reloads the Product Table (WCF<->WPT integration)
	// AND returns updated per-choice counts (/wcf/v1/counters) that grey/hide
	// unavailable choices instantly. This handler now only provides lightweight
	// visual feedback and re-locks the Product Table column widths after Barn2's
	// own redraw; it must NOT re-run productTable() or disable labels.
	$(document).on('click', '.wcf-filter label', function(e){
		if(!jQuery(this).hasClass('disabled')) {

			_filter_capture_product_table_widths(false);
			$('.inside-filter').fadeTo(300,0.6);

			// IMS NATIVE 2026-06-07 (audit Y4): the click triggers Barn2's own filter reload;
			// draw.wcpt / wcpf.filteringDone run the housekeeping + fade the sidebar back
			// in. This single bounded fallback guarantees the sidebar can never stay
			// dimmed if neither native event arrives.
			setTimeout(function(){
				if ( parseFloat($('.inside-filter').css('opacity')) < 1 ) {
					_filter_post_render_housekeeping();
					$('.inside-filter').stop(true).fadeTo(100,1);
				}
			}, 2500);
		}
	});	

	$(document).on('change', '#cgims-show', function(){
		var val = $(this).val();
		$('.wc-product-table-below select').val(val).change();
		_filter_apply_product_table_widths(100);
	});		
	
	/*$(".wc-product-table").on("init.wcpt", function(f,r){
		//console.log(r.dataTable.data());
		//console.log(r.dataTable.data().count());
		//console.log(r.dataTable.data().rows( { selected: true } ).count());
		//console.log(r.dataTable.data().length);
	});*/

	$(".wc-product-table").on("draw.dt", function(f,r){
		_filter_apply_product_table_widths(0);
		if( !$('.search-results').length && !(window.cims_wcf_compat && window.cims_wcf_compat.is_v2) ) {
			$('.dataTables_info').hide();
			setTimeout(function(){
				var count = 0;
				$('.wc-product-table tbody>tr').each(function(){count += 1;});
				$('.dataTables_info').html('<span class="total-parts">'+ product_count +`</span>&nbsp;${global_part_text} (<span class="displayed-counter"></span>&nbsp;Displayed)`);	
				$('.displayed-counter').text(count);
				$('.dataTables_info').show();
				_filter_apply_product_table_widths(0);
			
			}, 100);
		}
	});

	$(document).on("click", ".paginate_button", function(f,r){
		if ( window.cims_wcf_compat && window.cims_wcf_compat.is_v2 ) {
			return;
		}
		$('.dataTables_info').hide();
		setTimeout(function(){
			var count = 0;
			$('.wc-product-table tbody>tr').each(function(){count += 1;});
			$('.dataTables_info').html('<span class="total-parts">'+ product_count +`</span>&nbsp;${global_part_text} (<span class="displayed-counter"></span>&nbsp;Displayed)`);	
			$('.displayed-counter').text(count);
			$('.dataTables_info').show();	
			_filter_apply_product_table_widths(0);
		}, 100);
	});

	$(document).on('change', '.multi-cart-check input[type=checkbox]', function(){
		var collects = [];
		
		$('.multi-cart-form.btn-primary.btn').removeClass('this-product-quote this-product this-quote');
		
		$('.multi-cart-check input[type=checkbox]:checked').each(function(){
			if( $(this).val() != '' ) {
				collects.push('product');
			} else {
				collects.push('quote');
			}		
		});	

		if( collects.includes("product") && collects.includes("quote") ) {
			$('.multi-cart-form.btn-primary.btn').addClass('this-product-quote');
		} else if( collects.includes("product") ) {
			$('.multi-cart-form.btn-primary.btn').addClass('this-product');
		} else if( collects.includes("quote") ) {
			$('.multi-cart-form.btn-primary.btn').addClass('this-quote');
		}	
	});

	$(document).on("click", ".col-action .add-request-quote-button", function(e){
		$('.modal_notification').removeClass('active');
		var total = $('.multi-cart-check input:checked').length;
		if( $(this).hasClass('add-request-quote-button') ) {
			total = 1;
		}	
		setTimeout(function(){
			$.ajax({
				url : cims_home_url+woocommerce_params.ajax_url,
				type : "post",
				dataType : "html",
				data : {action: "catalogims_ajax_quote_info", total: total},
				success: function(data) {
					$('.modal_notification').html(data).addClass('active');
					setTimeout(function(){
						$('.modal_notification').removeClass('active');
					},10000);					
				}
			});		
		},1000);
	});
	
	$(document).on("click", ".col-action .single_add_to_cart_button", function(e){
		$('.modal_notification').removeClass('active');
		var total = $('.multi-cart-check input:checked').length;
		if( $(this).hasClass('single_add_to_cart_button') ) {
			total = 1;
		}		
		setTimeout(function(){		
			$.ajax({
				url : cims_home_url+woocommerce_params.ajax_url,
				type : "post",
				dataType : "html",
				data : {action: "catalogims_ajax_cart_info", total: total},
				success: function(data) {
					$('.modal_notification').html(data).addClass('active');
					setTimeout(function(){
						$('.modal_notification').removeClass('active');
					},10000);
				}
			});	
		},1000);
	});	

	$(document).on('change click', '.multi-cart-check input[type=checkbox]', function(){
		var count_check = $('.multi-cart-check input[type=checkbox]:checked').length;
