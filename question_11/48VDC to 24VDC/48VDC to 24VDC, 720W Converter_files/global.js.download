			if( $('.wc-product-table-multi-form .btn.custom').length==false ) {
					$('section.sub_cat_catalog .content-area .wrapper_area .right_area .bottom_area .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form,.search-results .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form').prepend(`
						<svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.02344 15.6562C7.83892 15.6562 8.5 14.9952 8.5 14.1797C8.5 13.3642 7.83892 12.7031 7.02344 12.7031C6.20795 12.7031 5.54688 13.3642 5.54688 14.1797C5.54688 14.9952 6.20795 15.6562 7.02344 15.6562Z" fill="black"/>
<path d="M12.9297 15.6562C13.7452 15.6562 14.4062 14.9952 14.4062 14.1797C14.4062 13.3642 13.7452 12.7031 12.9297 12.7031C12.1142 12.7031 11.4531 13.3642 11.4531 14.1797C11.4531 14.9952 12.1142 15.6562 12.9297 15.6562Z" fill="black"/>
<path d="M15.3887 2.09375H5.8033C5.69945 1.67096 5.59511 1.24473 5.48929 0.848023C5.33523 0.438523 5.06552 0.213102 4.69195 0.151086C4.65011 0.139273 4.60877 0.125 4.5625 0.125H4.53789C3.55155 0.125 1.11719 0.125 1.11719 0.125C0.845008 0.125 0.625 0.345008 0.625 0.617188V1.60156C0.625 1.87374 0.845008 2.09375 1.11719 2.09375C1.11719 2.09375 3.04656 2.09375 3.77992 2.09375C4.37301 4.3145 4.93115 7.02547 5.52423 9.24573C5.69945 9.71084 6.01544 9.95251 6.47612 9.96875C8.94248 9.96875 11.4083 9.96875 13.8742 9.96875C14.2896 9.96875 14.7203 9.66704 14.8261 9.24573C15.302 7.34539 15.778 5.42734 16.2534 3.52503C16.2943 3.3759 16.3346 3.22726 16.375 3.07812C16.375 2.53426 15.934 2.09375 15.3887 2.09375Z" fill="black"/>
</svg>
						`);
				$('section.sub_cat_catalog .content-area .wrapper_area .right_area .bottom_area .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form,.search-results .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form').addClass('btn-primary btn');
					// $('.wc-product-table-multi-form').append('<a class="btn btn-secondary custom request-compare" href="#"><img src="/wp-content/plugins/catalog-ims/assets/images/svg/compre-catalog.svg" alt="icon" /><span>Compare</span><img src="/wp-content/plugins/catalog-ims/assets/images/svg/arrow-right-icon.svg" alt="icon" /></a>');
					$('.wc-product-table-multi-form').append('<a class="btn btn-secondary custom request-info" href="/request-quote/"><img src="/wp-content/plugins/catalog-ims/assets/images/svg/rfi-catalog.svg" alt="icon" /><span>Request Information</span><img src="/wp-content/plugins/catalog-ims/assets/images/svg/arrow-right-icon.svg" alt="icon" /></a>');
			}
			$('.wc-product-table-multi-form').addClass('active');
			$('.wcf-wpt-table-wrapper .dataTables_wrapper').addClass('active');
		} else {
			$('.wc-product-table-multi-form .button.custom').remove();
			$('.wc-product-table-multi-form').removeClass('active');
			$('.wcf-wpt-table-wrapper .dataTables_wrapper').removeClass('active');
		}

	});
	
	$(document).on('change', '.wpt-bulk-select', function(){
		setTimeout(function(){
			var count_check = $('.multi-cart-check input[type=checkbox]:checked').length;

			if( count_check ) {
				if( $('.wc-product-table-multi-form .btn.custom').length==false ) {
					$('section.sub_cat_catalog .content-area .wrapper_area .right_area .bottom_area .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form,.search-results .wc-product-table-wrapper .wc-product-table-controls>div.wc-product-table-multi-form .multi-cart-form').prepend(`<svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M7.02344 15.6562C7.83892 15.6562 8.5 14.9952 8.5 14.1797C8.5 13.3642 7.83892 12.7031 7.02344 12.7031C6.20795 12.7031 5.54688 13.3642 5.54688 14.1797C5.54688 14.9952 6.20795 15.6562 7.02344 15.6562Z" fill="black"/>
<path d="M12.9297 15.6562C13.7452 15.6562 14.4062 14.9952 14.4062 14.1797C14.4062 13.3642 13.7452 12.7031 12.9297 12.7031C12.1142 12.7031 11.4531 13.3642 11.4531 14.1797C11.4531 14.9952 12.1142 15.6562 12.9297 15.6562Z" fill="black"/>
