	$(document).on('click', '.button.request-info', function(e){
		e.preventDefault();
		var href = $(this).attr('href');
		$(this).addClass('disabled');
		$('.request-info').text('Please wait...');
		var i = 0;
		var timeout = 0;
		$('.multi-cart-check input[type=checkbox]').each(function(){
			if($(this).is(':checked')) {
				var t = $(this);
				timeout = 1000*i;
				setTimeout(function(){
					t.parents('td').find('.add-request-quote-button').click();
					t.parents('tr').find('.add-request-quote-button').addClass('quote-checked');
				}, timeout);
				
				$(this).parents('tr').find('.single_add_to_cart_button img').attr('src', '/wp-content/plugins/catalog-ims/assets/images/svg/checklist_cart.svg');
				
				i++;
			}
		});
		
		setTimeout(function(){
			window.location.href = href;
		}, (1000*i)+1000);
	});

	function afterNotif() {
		if( $('.multi-cart-message .cart-success').length == 0 ) {
			$('.multi-cart-message').append('<p class="cart-success"><a href="/request-quote/" class="wc-forward">View Inquiry</a></p>');
		}	
		$('.multi-cart-check input[type=checkbox]').prop('checked', false);	
		$('.wc-product-table-wrapper').fadeTo(500,1);
		
		if ( !(window.cims_wcf_compat && window.cims_wcf_compat.is_v2) ) {
			$('body:not(.search-results) .cgims-extra-options-part-counter').html('<span>'+product_count+`</span> ${global_part_text}`);
		}
	}
	
	$(document).on('click', '.multi-cart-form.btn-primary.btn', function(e){
		var carts = [];
		var quotes = [];
		var collects = [];
		var total = 0;
		
		$('.wc-product-table-wrapper').fadeTo(500,0.4);
		
		$('.multi-cart-check input[name="wpt_product_price"]').each(function(){
			if($(this).is(':checked')) {
				var t = $(this);
				
				if( t.val() > 0 ) {
					carts.push(t.next().val()); 
				} else {
					quotes.push(t.parents('tr.product-row').find('.col-action .add-request-quote-button').attr('data-product_id'));
				}

				if( t.val() != '' ) {
					collects.push('product');
				} else {
					collects.push('quote');
				}					

				if(t.parents('tr').hasClass('purchasable')) {

				} else {
					t.parents('tr').find('.col-action .add-request-quote-button').addClass('quote-checked');
				}
				
				$(this).parents('tr').find('.single_add_to_cart_button img').attr('src', '/wp-content/plugins/catalog-ims/assets/images/svg/checklist_cart.svg');

				total++;
			}
		});

		$.ajax({
			url : cims_home_url+woocommerce_params.ajax_url,
			type : "post",
			dataType : "html",
			data : {action: "catalogims_ajax_bulk_quote", carts: carts, quotes: quotes},
			success: function(result) {
				result = JSON.parse(result);

				if( !result.success ) {
					alert('Something errors..');
					return false;
				}

				if( collects.includes("product") && collects.includes("quote") ) {
					$.ajax({
						url : cims_home_url+woocommerce_params.ajax_url,
						type : "post",
						dataType : "html",
						data : {action: "catalogims_ajax_cart_info", total: total},
						success: function(data) {
							afterNotif();
							$('.modal_notification').html(data).addClass('active');
							setTimeout(function(){
								$('.modal_notification').removeClass('active');
							},10000);
						}
					});	
				} else if( collects.includes("product") ) {
					$.ajax({
						url : cims_home_url+woocommerce_params.ajax_url,
						type : "post",
						dataType : "html",
						data : {action: "catalogims_ajax_cart_info", total: total},
						success: function(data) {
							$('.modal_notification').html(data).addClass('active');
							setTimeout(function(){
								$('.modal_notification').removeClass('active');
							},10000);
							afterNotif();

						}
					});
				} else if( collects.includes("quote") ) {
					$.ajax({
						url : cims_home_url+woocommerce_params.ajax_url,
						type : "post",
						dataType : "html",
						data : {action: "catalogims_ajax_quote_info", total: total, type: 'this-product-quote'},
						success: function(data) {
							$('.modal_notification').html(data).addClass('active');
							setTimeout(function(){
								$('.modal_notification').removeClass('active');
							},10000);
							afterNotif();
						
						}
					});		
				}
				
			}
		});			
	});

	// if(jQuery('body.yith-request-a-quote-page .woocommerce.ywraq-wrapper .ywraq-form-table-wrapper .return-to-shop .wc-backward').length) {
	// 	jQuery('body.yith-request-a-quote-page .woocommerce.ywraq-wrapper .ywraq-form-table-wrapper .return-to-shop .wc-backward').attr('href', '/product-category/molded-rubber-products/');
	// }

	jQuery(document).on('click', '.search_box #___gcse_1 .gsc-search-button-v2', function(e){
		e.preventDefault();
		console.log('helllow');
		let keyword = jQuery('.search_box #___gcse_1 input.gsc-input').val();
		if(keyword) {
