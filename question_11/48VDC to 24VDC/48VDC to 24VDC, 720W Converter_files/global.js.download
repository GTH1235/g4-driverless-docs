		}
	})


	/* ------------------------------------------------------------------
	 * CIMS-PRODUCT-COMPARE-QUOTE-02 (2026-07-31): shared selection toolbar.
	 * A leftmost checkbox column is rendered server-side (product-compare.php).
	 * The persistent toolbar exposes Add to Quote for 1–5 selections and Compare
	 * for 2–5. Quote invokes YITH's native delegated frontend handler sequentially,
	 * retaining its nonce/session/widget/event lifecycle instead of using the legacy
	 * Catalog IMS bulk endpoint. CIMS-PRODUCT-COMPARE-QUOTE-03 (2026-07-31) adds a
	 * View Quote navigation state only after the complete native queue succeeds. It
	 * re-binds on every Barn2 redraw/filter/paginate.
	 *
	 * NOTE the LEADING SEMICOLON: the preceding `jQuery(document).on(...)` handler
	 * has no trailing `;`, so without this `;` JS would parse `})( ... )(function(){...})`
	 * as a single call → "jQuery(...).on(...) is not a function" thrown in document.ready,
	 * which in jQuery 1.10.2 aborts the REST of the ready callbacks (killing Barn2's
	 * DataTables pagination init too). The whole block is also wrapped in try/catch so a
	 * compare bug can never again break the product table.
	 * ------------------------------------------------------------------ */
	;(function(){
	  try {
		var cfg = (typeof cims_compare_config !== 'undefined' && cims_compare_config) ? cims_compare_config : null;
		if ( ! cfg ) { return; }


		var MAX = parseInt(cfg.max, 10) > 0 ? parseInt(cfg.max, 10) : 5;
		var i18n = cfg.i18n || {};
		var quoteAvailable = cfg.quote_available !== false;
		var quoteUrl = (typeof cfg.quote_url === 'string' && cfg.quote_url) ? cfg.quote_url : '/request-quote/';
		var quoteBusy = false;
		var successfulQuoteSignature = ''; // sorted product IDs for the last complete native queue
		var selected = [];           // ordered list of selected product IDs (strings)
		var selectedQuoteNonces = {}; // product ID -> native YITH nonce
		var $modal = null;
		var lastFocus = null;

		function compareTables(){
			return $('table.wc-product-table').filter(function(){
				return $(this).find('.cims-compare-check').length > 0;
			});
		}

		function selectionHas(id){ return selected.indexOf(id) !== -1; }

		// Set semantics make the View Quote state survive Barn2 sort/redraw changes.
		function selectionSignature(ids){
			var signatureIds = (ids || selected).slice(0).map(String);
			signatureIds.sort(function(a, b){
				var aNumber = parseInt(a, 10);
				var bNumber = parseInt(b, 10);
				if ( ! isNaN(aNumber) && ! isNaN(bNumber) && aNumber !== bNumber ) { return aNumber - bNumber; }
				return a < b ? -1 : (a > b ? 1 : 0);
			});
			return signatureIds.join('|');
		}

		function addSelection(id, quoteNonce){
			if ( selectionHas(id) ) {
				if ( quoteNonce ) { selectedQuoteNonces[id] = quoteNonce; }
				return true;
			}
			if ( selected.length >= MAX ) { return false; }
			selected.push(id);
			selectedQuoteNonces[id] = quoteNonce || '';
			return true;
		}

		function removeSelection(id){
			var idx = selected.indexOf(id);
			if ( idx !== -1 ) { selected.splice(idx, 1); }
			delete selectedQuoteNonces[id];
		}

		// Keep checkbox checked state + disabled state in sync with `selected`
		// across the (re-rendered) rows of every compare table.
		function syncCheckboxes(){
			var atMax = selected.length >= MAX;
			$('.cims-compare-check').each(function(){
				var $cb = $(this);
				var id = String($cb.val());
				var isSel = selectionHas(id);
				if ( isSel && $cb.attr('data-quote-nonce') ) { selectedQuoteNonces[id] = String($cb.attr('data-quote-nonce')); }
				if ( $cb.prop('checked') !== isSel ) { $cb.prop('checked', isSel); }
				$cb.prop('disabled', quoteBusy || (!isSel && atMax));
				$cb.closest('.cims-compare-check-wrap').toggleClass('is-disabled', quoteBusy || (!isSel && atMax));
			});
		}

		function barMarkup(){
			var compare = (i18n.button || 'Compare');
			var quote = (i18n.quoteButton || 'Add to Quote');
			var clear = (i18n.clear || 'Clear Selection');
			return '' +
				'<div class="cims-compare-bar" role="region" aria-label="' + (i18n.title || 'Compare Products') + '">' +
					'<span class="cims-compare-bar-count" aria-live="polite"></span>' +
					'<button type="button" class="cims-quote-btn btn btn-primary" data-mode="add" aria-label="' + quote + '" title="' + quote + '" disabled>' +
						'<span class="cims-quote-btn-label">' + quote + '</span>' +
					'</button>' +
					'<button type="button" class="cims-compare-btn btn btn-primary" disabled>' +
						'<img class="cims-compare-btn-icon" src="/wp-content/plugins/catalog-ims/assets/images/svg/compre-catalog.svg" alt="" aria-hidden="true" />' +
						'<span class="cims-compare-btn-label">' + compare + '</span>' +
					'</button>' +
					'<button type="button" class="cims-compare-clear">' + clear + '</button>' +
					'<span class="cims-compare-bar-notice" aria-live="polite"></span>' +
				'</div>';
		}

		// Ensure exactly one compare bar sits directly above each compare table.
		function ensureBar(){
			compareTables().each(function(){
				var $table = $(this);
				// MACRO-PARENT (2026-06-12): on macro parent pages the Product Table is
				// AJAX-injected inside .product_table_wrap_new, which is watched by the
				// macro template's MutationObserver(childList+subtree). Anchor the bar
				// OUTSIDE that wrap (a sibling before it) so it (a) never re-triggers the
				// observer/width-lock loop and (b) survives table re-injects instead of
				// being wiped on every filter/paginate. Leaf path is unchanged.
				var $macro = $table.closest('.cims-macro-filter-results');
				if ( $macro.length ) {
					if ( $macro.find('.cims-compare-bar').length ) { return; }
					var $wrap = $table.closest('.product_table_wrap_new');
					if ( $wrap.length ) { $wrap.before(barMarkup()); }
					else { $macro.prepend(barMarkup()); }
					return;
				}
				var $anchor = $table.closest('.dataTables_wrapper');
				if ( ! $anchor.length ) { $anchor = $table; }
				if ( $anchor.prev('.cims-compare-bar').length ) { return; }
				$anchor.before(barMarkup());
			});
		}

		function updateBar(){
			var count = selected.length;
			var signature = selectionSignature();
			var mode = quoteBusy ? 'busy' : (signature && signature === successfulQuoteSignature ? 'view' : 'add');
			var label = mode === 'busy' ? (i18n.quoteAdding || 'Adding to Quote…') : (mode === 'view' ? (i18n.quoteView || 'View Quote') : (i18n.quoteButton || 'Add to Quote'));
			var quoteDisabled = mode === 'busy' || (mode === 'add' && (count < 1 || !quoteAvailable));
			$('.cims-compare-bar').each(function(){
				var $bar = $(this);
				var $quote = $bar.find('.cims-quote-btn');
				$bar.prop('hidden', false);
				$bar.attr('aria-busy', quoteBusy ? 'true' : 'false').toggleClass('is-quote-busy', quoteBusy);
				$bar.find('.cims-compare-bar-count').text(count + ' selected');
				$quote.prop('disabled', quoteDisabled).attr('data-mode', mode).attr('aria-label', label).attr('title', label).attr('aria-busy', mode === 'busy' ? 'true' : 'false');
				$bar.find('.cims-compare-btn').prop('disabled', count < 2 || quoteBusy);
				$bar.find('.cims-quote-btn-label').text(label);
			});
		}

		function flashNotice(msg){
			var $n = $('.cims-compare-bar-notice');
			$n.text(msg);
			clearTimeout(flashNotice._t);
			flashNotice._t = setTimeout(function(){ $n.text(''); }, 3500);
		}

		function refresh(){
			ensureBar();
			syncCheckboxes();
			updateBar();
		}

		// Build an invisible YITH-compatible button. The nested .cart wrapper makes
		// YITH serialize an empty form safely; product ID + nonce are then appended by YITH.
		function quoteProxy(id){
			var nonce = selectedQuoteNonces[id] || '';
			if ( ! nonce ) { return $(); }
			return $('<div class="cims-quote-native-proxy yith-ywraq-add-to-quote"><div class="yith-ywraq-add-button cart"><a href="#" class="add-request-quote-button" aria-hidden="true" tabindex="-1"></a></div></div>')
				.find('.add-request-quote-button')
				.attr('data-product_id', id)
				.attr('data-wp_nonce', nonce)
				.closest('.cims-quote-native-proxy');
		}

		// YITH allows a single in-flight XHR, so process the checked products serially.
		function addSelectedToQuote(){
			if ( quoteBusy ) { return; }
			if ( ! quoteAvailable ) {
				flashNotice(i18n.quoteUnavailable || 'Request a Quote is currently unavailable.');
				return;
			}
			var queue = selected.slice(0, MAX);
			if ( ! queue.length ) { return; }
			var batchSignature = selectionSignature(queue);
			successfulQuoteSignature = '';
			quoteBusy = true;
			syncCheckboxes();
			updateBar();
			var index = 0;
			var failed = false;

			function finish(){
				quoteBusy = false;
				successfulQuoteSignature = failed ? '' : batchSignature;
				syncCheckboxes();
				updateBar();
				flashNotice(failed ? (i18n.quoteError || 'Unable to add the selected products to Quote. Please try again.') : (i18n.quoteSuccess || 'Selected products added to Quote.'));
			}

			function next(){
				if ( failed || index >= queue.length ) { finish(); return; }
				var id = String(queue[index]);
				var $proxy = quoteProxy(id);
				if ( ! $proxy.length ) { failed = true; finish(); return; }
				var eventNamespace = '.cimsQuoteQueue';
				var timeout = setTimeout(function(){
					$(document).off(eventNamespace);
					$proxy.remove();
					failed = true;
					finish();
				}, 30000);
				$(document).one('yith_wwraq_added_successfully' + eventNamespace, function(e, response, productId){
					if ( productId && String(productId) !== id ) { return; }
					if ( response && typeof response.rqa_url === 'string' && response.rqa_url ) { quoteUrl = response.rqa_url; }
					clearTimeout(timeout);
					$(document).off(eventNamespace);
					$proxy.remove();
					index++;
					flashNotice((i18n.quoteProgress || 'Adding %1$d of %2$d to Quote…').replace('%1$d', index).replace('%2$d', queue.length));
					setTimeout(next, 0);
				});
				$(document).one('yith_wwraq_error_while_adding' + eventNamespace, function(){
					clearTimeout(timeout);
					$(document).off(eventNamespace);
					$proxy.remove();
					failed = true;
					finish();
				});
				$('body').append($proxy);
				$proxy.find('.add-request-quote-button').trigger('click');
			}
			next();
		}

		// Collect the current header label map (tax token -> visible heading text)
		// from a compare table, so the modal rows MATCH the current contextual display.
		function collectLabels(){
			var labels = {};
			var $table = compareTables().filter(':visible').first();
			if ( ! $table.length ) { $table = compareTables().first(); }
			$table.find('thead th').each(function(){
				var name = $(this).attr('data-name') || '';
				if ( name.indexOf('tax:') === 0 ) {
					var txt = $.trim($(this).text());
					if ( txt ) { labels[name] = txt; }
				}
			});
			return labels;
		}

		/* ----- Modal ----- */
		function ensureModal(){
			if ( $modal && $modal.length ) { return $modal; }
			$modal = $('' +
				'<div class="cims-compare-modal" hidden>' +
					'<div class="cims-compare-modal-overlay"></div>' +
					'<div class="cims-compare-modal-dialog" role="dialog" aria-modal="true" aria-label="' + (i18n.title || 'Compare Products') + '" tabindex="-1">' +
						'<div class="cims-compare-modal-header">' +
							'<h2 class="cims-compare-modal-title">' + (i18n.title || 'Compare Products') + '</h2>' +
							'<button type="button" class="cims-compare-modal-close" aria-label="' + (i18n.close || 'Close') + '">' +
								'<img src="/wp-content/plugins/catalog-ims/assets/images/svg/catalog_close_new.svg" alt="' + (i18n.close || 'Close') + '" />' +
							'</button>' +
						'</div>' +
						'<div class="cims-compare-modal-body"></div>' +
					'</div>' +
				'</div>');
			$('body').append($modal);
			return $modal;
		}

		function openModal(){
			ensureModal();
			lastFocus = document.activeElement;
			$modal.prop('hidden', false);
			$('body').addClass('cims-compare-open');
			$modal.find('.cims-compare-modal-dialog').focus();
		}

		function closeModal(){
			if ( ! $modal ) { return; }
			$modal.prop('hidden', true);
			$('body').removeClass('cims-compare-open');
			if ( lastFocus && lastFocus.focus ) { try { lastFocus.focus(); } catch(e){} }
		}

		function loadComparison(){
			if ( selected.length < 2 ) {
				flashNotice(i18n.minNotice || 'Select at least two products to compare.');
				return;
			}
			ensureModal();
			$modal.find('.cims-compare-modal-body').html('<div class="cims-compare-loading">' + (i18n.loading || 'Loading…') + '</div>');
			openModal();

			$.ajax({
				url: cfg.ajax_url,
				type: 'POST',
				dataType: 'json',
				data: {
					action: cfg.action || 'cims_compare_products',
					nonce: cfg.nonce,
					ids: selected,
					labels: collectLabels(),
					term_id: cfg.term_id || 0
				}
			}).done(function(resp){
				if ( resp && resp.success && resp.data && resp.data.html ) {
					$modal.find('.cims-compare-modal-body').html(resp.data.html);
				} else {
					var msg = (resp && resp.data && resp.data.message) ? resp.data.message : (i18n.error || 'Sorry, the comparison could not be loaded.');
					$modal.find('.cims-compare-modal-body').html('<div class="cims-compare-error">' + msg + '</div>');
				}
			}).fail(function(){
				$modal.find('.cims-compare-modal-body').html('<div class="cims-compare-error">' + (i18n.error || 'Sorry, the comparison could not be loaded.') + '</div>');
			});
		}

		/* ----- Events ----- */
		$(document).on('change', '.cims-compare-check', function(){
			if ( quoteBusy ) { syncCheckboxes(); return; }
			// A human selection edit starts a new batch; redraw synchronization does not fire change.
			successfulQuoteSignature = '';
			var id = String($(this).val());
			if ( $(this).prop('checked') ) {
				if ( ! addSelection(id, String($(this).attr('data-quote-nonce') || '')) ) {
					$(this).prop('checked', false);
					flashNotice((i18n.maxNotice || 'You can compare up to 5 products.'));
				}
			} else {
				removeSelection(id);
			}
			syncCheckboxes();
			updateBar();
		});

		$(document).on('click', '.cims-quote-btn', function(e){
			e.preventDefault();
			if ( ($(this).attr('data-mode') || 'add') === 'view' ) {
				window.location.assign(quoteUrl);
				return;
			}
			addSelectedToQuote();
		});

		$(document).on('click', '.cims-compare-btn', function(e){
			e.preventDefault();
			loadComparison();
		});

		$(document).on('click', '.cims-compare-clear', function(e){
			e.preventDefault();
			if ( quoteBusy ) { return; }
			selected = [];
			selectedQuoteNonces = {};
			successfulQuoteSignature = '';
			syncCheckboxes();
			updateBar();
		});

		$(document).on('click', '.cims-compare-modal-close, .cims-compare-modal-overlay', function(e){
			e.preventDefault();
			closeModal();
		});

		$(document).on('keydown', function(e){
			if ( e.key === 'Escape' && $modal && ! $modal.prop('hidden') ) {
				closeModal();
			}
		});

		// Re-bind on Barn2 redraws (filter / paginate / sort / show-count). Bound on
		// `document` (delegated) + Barn2's own native events — NOT a document-wide
		// `ajaxComplete` (that fired on every unrelated AJAX). Each handler is itself
		// guarded so a refresh error can't escape into Barn2's draw pipeline.
		$(document).on('draw.dt draw.wcpt', '.wc-product-table', function(){
			try { refresh(); } catch(e) { if (window.console) { console.error('cims compare refresh error', e); } }
		});
		if ( window.wp && wp.hooks && typeof wp.hooks.addAction === 'function' ) {
			wp.hooks.addAction('wcpf.filteringDone', 'cims/compare-refresh', function(){ setTimeout(function(){ try { refresh(); } catch(e){} }, 0); });
			wp.hooks.addAction('wcpf.wpt.filteringDone', 'cims/compare-refresh', function(){ setTimeout(function(){ try { refresh(); } catch(e){} }, 0); });
		}
		function queueWcf2CompareRefresh() {
			var attempt = 0;
			function run() {
				attempt++;
				try { refresh(); } catch(e) {}
				if ( compareTables().length && !$('.cims-compare-bar').length && attempt < 12 ) {
					setTimeout(run, 250);
				}
			}
			run();
		}
		// WCF 2 dispatches native CustomEvents. jQuery's synthetic event bridge is
		// unreliable for this portal redraw path, so subscribe at the document API.
		document.addEventListener('wcf:products:afterRender', queueWcf2CompareRefresh);

		// Initial pass (and a short retry while Barn2 boots the first table).
		refresh();
		var _tries = 0;
		var _boot = setInterval(function(){
			_tries++;
			try { refresh(); } catch(e) {}
			if ( compareTables().length || _tries > 20 ) { clearInterval(_boot); }
		}, 250);
	  } catch (e) {
		// Never let a compare-feature error break Barn2's DataTables / pagination.
		if ( window.console ) { console.error('CIMS-PRODUCT-COMPARE-01 init error (table unaffected):', e); }
	  }
	})();

});


